<view class="container">
  <view
    class="item-{{index}}"
    wx:for="{{items}}"
    wx:key="id"
    wx:for-item="item"
    wx:for-index="index"
  >
    <view class="header">
      <text class="title">{{item.title}}</text>
      <text wx:if="{{item.isNew}}" class="tag">新</text>
    </view>
    <view class="content">
      <text>{{item.description}}</text>
      <image
        wx:if="{{item.image}}"
        src="{{item.image}}"
        bind:tap="onImageTap" />
    </view>
    <view class="actions">
      <button
        wx:if="{{item.canEdit}}"
        bind:tap="onEdit"
        data-id="{{item.id}}"
      >
        编辑
      </button>
      <button bind:tap="onDelete" data-id="{{item.id}}">删除</button>
    </view>
  </view>
